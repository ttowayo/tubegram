# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- YouTube Data API v3 (Google Cloud). 없어도 RSS/oEmbed/스크래핑으로 동작하지만 권장 ---
YOUTUBE_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# 웹훅 검증용 임의 문자열 (영문/숫자/_/- 만, 1~256자)
TELEGRAM_WEBHOOK_SECRET=
# 봇을 쓸 수 있는 chat_id 목록 (쉼표 구분). 첫 번째가 오너(사이트 등록 시 수신자)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- 서버 보안 ---
# /api/poll, /api/cron/daily, WebSub 서명에 사용. Vercel Cron도 이 값을 Bearer 로 보냄
CRON_SECRET=
# 사이트 등록 폼 토큰
REGISTER_TOKEN=

# --- 배포 URL (WebSub 콜백, 텔레그램 웹훅). 예: https://tubegram.vercel.app ---
APP_URL=

# --- 필터/한도 ---
MAX_VIDEO_MINUTES=90
MIN_VIDEO_SECONDS=60
DAILY_VIDEO_MINUTES_BUDGET=420
